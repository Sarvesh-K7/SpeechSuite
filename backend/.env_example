# Flask
SECRET_KEY=change-me-to-a-random-secret

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=speech_to_text
# Or set the full URI directly instead of the DB_* vars above:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/speech_to_text

# ---- Speech-to-Text ----
# whisper (self-hosted, default) | elevenlabs (cloud)
STT_PROVIDER=whisper

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_MODEL=scribe_v1

WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ---- Text-to-Speech ----
# piper (self-hosted, default) | elevenlabs (cloud)
TTS_PROVIDER=piper

ELEVENLABS_TTS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

PIPER_VOICE=en_US-lessac-medium

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
